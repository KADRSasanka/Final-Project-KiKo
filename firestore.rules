rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each grown-up can only touch their own data.
    match /users/{uid}/children/{childId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.age is int
        && request.resource.data.age >= 8
        && request.resource.data.age <= 12;

      // Level progress: one doc per track
      match /progress/{trackId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
